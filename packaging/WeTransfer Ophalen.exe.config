<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows zet op elk bestand dat uit een gedownloade ZIP komt het "Mark of the
  Web". De .NET-runtime weigert zulke bestanden te laden via Assembly.LoadFrom,
  en dan stopt de app meteen met:
  "Failed to resolve Python.Runtime.Loader.Initialize".

  Deze config, die naast de .exe moet staan, geeft die bestanden volledig
  vertrouwen. Zonder dit bestand start de app dus niet als iemand hem uit de
  Downloadmap heeft uitgepakt.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
